# Copy to .env (mode 600) and fill in real values. Never commit .env.
DJANGO_SETTINGS_MODULE=config.settings.local
SECRET_KEY=replace-with-50-random-characters
DEBUG=true
ALLOWED_HOSTS=127.0.0.1,localhost
CSRF_TRUSTED_ORIGINS=http://localhost:5173

# PostgreSQL: own database and role (the role is created once with sudo -u postgres psql)
DATABASE_URL=postgres://rag_app:change-me-rag-app@127.0.0.1:5432/rag_platform

# Redis: database 2 = Celery broker, database 3 = cache (0 and 1 are used by another project)
CELERY_BROKER_URL=redis://127.0.0.1:6379/2
CACHE_URL=redis://127.0.0.1:6379/3

# MinIO (S3 API) — the app user, not the root user
S3_ENDPOINT_URL=http://127.0.0.1:9000
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_BUCKET_ORIGINALS=rag-originals
S3_BUCKET_ARTIFACTS=rag-artifacts
S3_BUCKET_EXPORTS=rag-exports

# Qdrant
QDRANT_URL=http://127.0.0.1:6333
QDRANT_API_KEY=

# OpenSearch — own service user, not admin
OPENSEARCH_URL=https://127.0.0.1:9200
OPENSEARCH_USER=
OPENSEARCH_PASSWORD=
OPENSEARCH_CA_CERT=

# LLM through LiteLLM -> Ollama (CPU)
LLM_MODEL=ollama/qwen2.5:3b
LLM_FALLBACK_MODEL=ollama/qwen2.5:1.5b
OLLAMA_API_BASE=http://127.0.0.1:11434

# Local models (folders, never downloaded at runtime)
EMBEDDING_MODEL_DIR=/home/USER/rag-data/models/multilingual-e5-small
RERANKER_MODEL_DIR=/home/USER/rag-data/models/ms-marco-MiniLM-L6-v2
HF_HUB_OFFLINE=1
TRANSFORMERS_OFFLINE=1
OMP_NUM_THREADS=4

UPLOAD_MAX_BYTES=52428800
SESSION_IDLE_MINUTES=30
# true = the Admin role must sign in with an authenticator-app code too
MFA_REQUIRED_FOR_ADMINS=false
SESSION_MAX_HOURS=8
LOG_LEVEL=INFO
